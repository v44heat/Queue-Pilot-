# ---- Flask ----
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# ---- PostgreSQL (local Windows install) ----
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://queuepilot_user:your_password_here@localhost:5432/queuepilot

# ---- CORS / Frontend ----
CORS_ORIGINS=http://localhost:5173

# ---- Rate limiting (in-memory; no Redis) ----
RATELIMIT_DEFAULT=200 per hour

# ---- Timezone used for DISPLAY only (timestamps are stored in UTC) ----
APP_TIMEZONE=Africa/Nairobi
